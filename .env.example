# QuickBasket 2026 — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
API_PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/quickbasket

# JWT
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Identity Services — use the SAME Web Client ID in both variables.
# The NEXT_PUBLIC_ value is public and safe for the browser.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# Optional AI assistant
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional local admin bootstrap
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
