# ─────────────────────────────────────────────────────────────────────────────
# QuickBasket 2026 — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node environment ──────────────────────────────────────────────────────────
# "development" | "production" | "test"
NODE_ENV=development

# ── Express API ───────────────────────────────────────────────────────────────
# Port the Express server listens on locally.
API_PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full MongoDB connection URI.
# For local Docker development: mongodb://mongo:27017/quickbasket
# For local non-Docker development: mongodb://localhost:27017/quickbasket
MONGODB_URI=mongodb://localhost:27017/quickbasket

# ── JWT ───────────────────────────────────────────────────────────────────────
# A long, random secret string. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Token expiry — e.g. "7d", "24h"
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# The origin(s) allowed to call the API. In development this is the Next.js dev server.
# Multiple origins: comma-separated   e.g. http://localhost:3000,https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ── Next.js frontend ─────────────────────────────────────────────────────────
# The public base URL of the Express API, used by Next.js to build fetch URLs.
# During Docker Compose local dev, use the service name: http://api:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── AI grocery assistant (optional for local development) ─────────────────────
# Server-side only. Never use a NEXT_PUBLIC_ prefix for API keys.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
